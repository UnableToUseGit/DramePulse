{
  "expo": {
    "name": "DramePulse Player",
    "owner": "minghaoqin",
    "slug": "dramepulse-player-demo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dramepulse",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.dramepulse.playerdemo",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSMicrophoneUsageDescription": "DramePulse 需要使用麦克风把你的语音指令转成观看助手文本。"
      },
      "supportsTablet": false
    },
    "android": {
      "package": "com.dramepulse.playerdemo",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-audio",
      "expo-video",
      "expo-font",
      "expo-asset",
      "./plugins/withAndroidCleartextTraffic"
    ],
    "extra": {
      "eas": {
        "projectId": "a1128f65-aa37-41ea-b1ed-8777b60fb7f1"
      }
    }
  }
}
