# Backend mode
DRAMEPULSE_MODE=local
SQLITE_PATH=dramepulse.sqlite
LOCAL_OSS_ROOT=.
LOCAL_OSS_BUCKET=local

# Aliyun transcription
ALIYUN_API_KEY=
DASHSCOPE_API_KEY=

# Cloud backend: set DRAMEPULSE_MODE=cloud before using MySQL/OSS below.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=false
MYSQL_DATABASE=dramepulse

OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_BUCKET=
OSS_REGION=cn-beijing
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
CDN_BASE_URL=http://cdn.threekeyboardists.top

# Local tool paths
FFMPEG_BIN=
FFPROBE_BIN=

# Multimodal LLM for highlight recognition
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL=Doubao-Seed-2.0-pro

# Optional fallback multimodal LLM
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional story Q&A RAG API
STORY_QA_BACKEND=chroma
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=dramepulse_story_qa
SIMILARITY_TOP_K=8

# Optional LightRAG backend for Story Q&A. Put each prebuilt working directory at
# LIGHTRAG_WORKING_ROOT/{series_id}/lightrag. Query current_episode is passed as
# LightRAG current_chapter_id; current_time is not used for LightRAG filtering.
LIGHTRAG_WORKING_ROOT=data/story_qa
LIGHTRAG_QUERY_MODE=hybrid
LIGHTRAG_ENABLE_RERANK=false
LIGHTRAG_TOP_K=6
LIGHTRAG_CHUNK_TOP_K=4
LIGHTRAG_COSINE_THRESHOLD=0.4
LIGHTRAG_MAX_ENTITY_TOKENS=1800
LIGHTRAG_MAX_RELATION_TOKENS=2400
LIGHTRAG_MAX_TOTAL_TOKENS=6000
LIGHTRAG_RESPONSE_TYPE=一句话短回答，最多60个中文字，不要引用来源，不要输出References，不要输出思考过程
LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-small
LIGHTRAG_EMBEDDING_DIM=1536
LIGHTRAG_EMBEDDING_API_BASE=https://api.openai.com/v1
LIGHTRAG_EMBEDDING_API_KEY=
LIGHTRAG_EMBEDDING_SEND_DIM=false

# Optional video analyzer integration. Keep video-analyzer in a separate
# environment and point DramePulse at that Python executable.
VIDEO_ANALYZER_PYTHON=
VIDEO_ANALYZER_PROJECT=
VIDEO_ANALYZER_RESULT_ROOT=video-analyzer_result
VIDEO_ANALYZER_CLIENT=openai_api
VIDEO_ANALYZER_API_BASE=
VIDEO_ANALYZER_API_KEY=
VIDEO_ANALYZER_MODEL=
VIDEO_ANALYZER_WHISPER_MODEL=small
VIDEO_ANALYZER_MAX_FRAMES=30
